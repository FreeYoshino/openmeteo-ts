{
    "name": "openmeteo-ts",
    "version": "0.0.1",
    "type": "module",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsx --watch src/index.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run --dir tests/unit",
        "test:integration": "vitest run --dir tests/integration",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FreeYoshino/openmeteo-ts.git"
    },
    "keywords": [
        "open-meteo",
        "weather",
        "api",
        "sdk",
        "typescript",
        "weather-api",
        "forecast",
        "zero-dependency"
    ],
    "author": "FreeYoshino",
    "license": "ISC",
    "engines": {
        "node": ">=18.0.0"
    },
    "bugs": {
        "url": "https://github.com/FreeYoshino/openmeteo-ts/issues"
    },
    "homepage": "https://github.com/FreeYoshino/openmeteo-ts#readme",
    "description": "Zero-dependency, strongly-typed TypeScript SDK for the Open-Meteo Weather API with extensible analyzer plugin system"
}
